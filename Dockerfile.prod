# Dockerfile.prod - Production environment
# Use this for building production-ready images with proper server

# Shared PHP base stage with runtime extensions.
FROM php:8.4-fpm@sha256:072b8cdef8072604ae97fde8bbc003e60e815314724e232bf7e34950640c7044 AS php-base

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    unzip \
    zip \
    libzip-dev \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    && docker-php-ext-install pdo_mysql zip mbstring exif pcntl bcmath gd \
    && rm -rf /var/lib/apt/lists/*

# PHP builder stage: install Composer dependencies.
FROM php-base AS builder

COPY --from=composer:2@sha256:a3df561dbdddfdb9832ec50f41c0e2f1d27445a67bd71415f05467fedbb2c3c7 /usr/bin/composer /usr/local/bin/composer

WORKDIR /var/www/html

COPY . ./
RUN composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader

# Node builder stage: install JS dependencies and build assets.
FROM node:20-alpine@sha256:afdf98210b07b586eb71fa22ba2e432e058e4cd1304d31ed60888755b8c865fb AS node-builder
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY --from=builder /var/www/html /app
RUN npm run build

# Application builder stage with compiled frontend assets.
FROM builder AS app-builder

COPY --from=node-builder /app/public/build /var/www/html/public/build

# Production PHP-FPM stage.
FROM php-base AS php-runtime

WORKDIR /var/www/html

# Create non-root user for security.
RUN useradd -m -u 1000 laravel

# Copy application from builder.
COPY --from=app-builder /var/www/html /var/www/html

# Keep application code read-only to the runtime user and only allow Laravel
# to write its runtime storage and cache paths.
RUN set -eux; \
    find /var/www/html -type d -exec chmod 755 {} +; \
    find /var/www/html -type f -exec chmod 644 {} +; \
    mkdir -p storage/app storage/framework/cache storage/framework/sessions storage/framework/views storage/logs bootstrap/cache; \
    chown -R laravel:laravel storage/app storage/framework/cache storage/framework/sessions storage/framework/views storage/logs bootstrap/cache

# Configure PHP-FPM.
RUN mkdir -p /run/php && chown -R laravel:laravel /run/php

# Switch to non-root user.
USER laravel

EXPOSE 9000

# Health check.
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
    CMD php -r "echo 'ok';" || exit 1

ENTRYPOINT ["sh", "docker-entrypoint.sh"]
CMD ["php-fpm"]

# Production Nginx stage.
FROM nginx:stable-alpine@sha256:e544ba68e68ddbcdff106010fa82f4ab30378899e78d4ff7aadf4ef5a7c65091 AS nginx-runtime

COPY nginx/default.conf /etc/nginx/conf.d/default.conf

WORKDIR /var/www/html

# Create non-root user.
RUN addgroup -g 1000 laravel && adduser -D -u 1000 -G laravel laravel

# Copy static files and built app from PHP builder.
COPY --from=app-builder /var/www/html/public /var/www/html/public

# Set permissions.
RUN set -eux; \
    find /var/www/html -type d -exec chmod 755 {} +; \
    find /var/www/html -type f -exec chmod 644 {} +

# Install curl for health checks and patch vulnerable runtime libraries.
RUN apk upgrade --no-cache nghttp2-libs \
    && apk add --no-cache curl

# Switch to non-root user.
USER laravel

EXPOSE 80

# Health check.
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
    CMD curl --fail http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
